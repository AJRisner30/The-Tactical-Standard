{
  "entities": {
    "Athlete": {
      "title": "Athlete",
      "description": "Athlete profile for personal stats, biometrics, training goals, and performance tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the athlete" },
        "userId": { "type": "string", "description": "Firebase Auth user ID of the owner" },
        "name": { "type": "string", "maxLength": 100, "description": "Athlete full name or callsign" },
        "email": { "type": "string", "maxLength": 150, "description": "Athlete email address" },
        "avatarColor": { "type": "string", "maxLength": 60, "description": "Gradient visual theme class" },
        "joinedDate": { "type": "string", "maxLength": 40, "description": "Date or month joined" },
        "experienceLevel": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced", "Elite"],
          "description": "Training background experience level"
        },
        "primaryGoal": {
          "type": "string",
          "enum": ["Hybrid Athlete", "Strength & Power", "Hypertrophy", "Tactical & Rucking", "Endurance & Running"],
          "description": "Primary fitness goal focus"
        },
        "weightLbs": { "type": "number", "description": "Bodyweight in pounds" },
        "restingHr": { "type": "number", "description": "Resting heart rate in beats per minute" },
        "maxHr": { "type": "number", "description": "Estimated maximum heart rate" },
        "notes": { "type": "string", "maxLength": 1000, "description": "Personal athlete notes" },
        "subscription": { "type": "object", "description": "Active Square subscription status and tier" },
        "trialActivation": { "type": "object", "description": "14-day free trial start and expiration timestamps" },
        "trialState": { "type": "object", "description": "Cached trial state record" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "name", "email", "experienceLevel", "primaryGoal"]
    },
    "WorkoutSessionLog": {
      "title": "WorkoutSessionLog",
      "description": "Recorded workout session log with completed sets, tonnage volume, time, and exercise performance metrics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the workout log session" },
        "userId": { "type": "string", "description": "Firebase Auth user ID of the athlete who completed the workout" },
        "athleteId": { "type": "string", "description": "Associated athlete identifier" },
        "athleteName": { "type": "string", "maxLength": 100, "description": "Athlete display name or callsign" },
        "userEmail": { "type": "string", "maxLength": 150, "description": "Account email of athlete" },
        "isCoachLog": { "type": "boolean", "description": "True if this session log belongs to Head Coach Aryan Risner (publicly viewable by all users)" },
        "programId": { "type": "string", "description": "Optional program identifier" },
        "workoutTitle": { "type": "string", "maxLength": 150, "description": "Workout name or protocol focus" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Workout date in YYYY-MM-DD format" },
        "startTime": { "type": "string", "maxLength": 40, "description": "Session start timestamp or time string" },
        "endTime": { "type": "string", "maxLength": 40, "description": "Session end timestamp or time string" },
        "durationMinutes": { "type": "number", "description": "Total workout duration in minutes" },
        "totalVolumeLbs": { "type": "number", "description": "Accumulated tonnage volume lifted in pounds" },
        "totalSetsCompleted": { "type": "number", "description": "Count of successfully completed sets" },
        "rating": { "type": "number", "description": "Subjective session rating 1-5" },
        "notes": { "type": "string", "maxLength": 1000, "description": "Session reflections and coaching notes" },
        "exercises": { "type": "array", "description": "Array of exercise performance records with set details" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "workoutTitle", "date", "durationMinutes", "totalVolumeLbs", "totalSetsCompleted"]
    },
    "CustomProgram": {
      "title": "CustomProgram",
      "description": "User custom workout program and exercise templates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the workout program" },
        "userId": { "type": "string", "description": "Firebase Auth user ID of the program creator" },
        "title": { "type": "string", "maxLength": 120, "description": "Program title" },
        "subtitle": { "type": "string", "maxLength": 200, "description": "Program subtitle" },
        "category": { "type": "string", "maxLength": 60, "description": "Training category" },
        "frequency": { "type": "string", "maxLength": 80, "description": "Training days and frequency" },
        "estimatedDurationMinutes": { "type": "number", "description": "Estimated workout duration" },
        "description": { "type": "string", "maxLength": 2000, "description": "Program overview and instructions" },
        "exercises": { "type": "array", "description": "List of template exercises" },
        "schedule": { "type": "array", "description": "Day-by-day training schedule objects" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "title", "category", "exercises"]
    },
    "RuckSessionLog": {
      "title": "RuckSessionLog",
      "description": "Logged rucking session tracking distance, pack weight, duration, pace, workload, and terrain.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the rucking session log" },
        "userId": { "type": "string", "description": "Firebase Auth user ID of the athlete" },
        "athleteId": { "type": "string", "description": "Athlete profile identifier" },
        "title": { "type": "string", "maxLength": 150, "description": "Title or route name" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Date in YYYY-MM-DD format" },
        "distanceMiles": { "type": "number", "description": "Distance rucked in miles" },
        "weightLbs": { "type": "number", "description": "Ruck pack weight in pounds" },
        "durationMinutes": { "type": "number", "description": "Duration in minutes" },
        "paceMinPerMile": { "type": "number", "description": "Calculated or logged pace in minutes per mile" },
        "workloadIndex": { "type": "number", "description": "Calculated workload index (distance * weight)" },
        "terrain": { "type": "string", "maxLength": 60, "description": "Terrain type" },
        "heartRateAvg": { "type": "number", "description": "Average heart rate in BPM" },
        "rpe": { "type": "number", "description": "Rate of perceived exertion 1-10" },
        "notes": { "type": "string", "maxLength": 1000, "description": "Coaching points, weather, or notes" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "date", "distanceMiles", "weightLbs", "durationMinutes"]
    },
    "OfficerProgram": {
      "title": "OfficerProgram",
      "description": "Custom individualized officer training program uploaded specifically to an individual officer account and visible only to them.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique program identifier" },
        "officerUserId": { "type": "string", "description": "Target officer's Firebase Auth User ID (only they and admin can access)" },
        "officerEmail": { "type": "string", "maxLength": 150, "description": "Officer's email address" },
        "officerName": { "type": "string", "maxLength": 100, "description": "Officer's badge name or callsign" },
        "badgeNumber": { "type": "string", "maxLength": 40, "description": "Officer badge/ID number" },
        "department": { "type": "string", "maxLength": 120, "description": "Agency or department name" },
        "programTitle": { "type": "string", "maxLength": 150, "description": "Title of the assigned individualized program" },
        "programSubtitle": { "type": "string", "maxLength": 250, "description": "Focus or operational description" },
        "category": { "type": "string", "maxLength": 60, "description": "Training category" },
        "coachNotes": { "type": "string", "maxLength": 3000, "description": "Confidential individualized coach notes and prescription instructions" },
        "frequency": { "type": "string", "maxLength": 80, "description": "Assigned weekly split/frequency" },
        "estimatedDurationMinutes": { "type": "number", "description": "Estimated duration in minutes" },
        "scheduleDays": { "type": "array", "description": "Array of day-by-day training schedule objects" },
        "exercises": { "type": "array", "description": "List of core prescribed exercises" },
        "assignedByEmail": { "type": "string", "maxLength": 150, "description": "Email of the coach who assigned the program" },
        "assignedAt": { "type": "string", "description": "Timestamp when the program was uploaded" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "officerUserId", "programTitle", "category"]
    },
    "CoachProgram": {
      "title": "CoachProgram",
      "description": "Shared custom workout programs and standalone single workouts published exclusively by Coach Aryan Risner (risneraryan@gmail.com) supporting Straight Sets, Supersets, EMOM, AMRAP, and Circuits.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the coach program or workout" },
        "title": { "type": "string", "maxLength": 150, "description": "Program or workout title" },
        "subtitle": { "type": "string", "maxLength": 300, "description": "Focus or subtitle" },
        "category": { "type": "string", "maxLength": 80, "description": "Training category" },
        "programKind": { "type": "string", "enum": ["program", "single_workout"], "description": "Whether this is a multi-day program or a single workout" },
        "frequency": { "type": "string", "maxLength": 100, "description": "Weekly frequency" },
        "estimatedDurationMinutes": { "type": "number", "description": "Estimated session duration" },
        "description": { "type": "string", "maxLength": 5000, "description": "Program intent and overview" },
        "exercises": { "type": "array", "description": "Day 1 or single-session template blocks" },
        "schedule": { "type": "array", "description": "Multi-day training schedule blocks" },
        "isPublished": { "type": "boolean", "description": "True when published for all authenticated users" },
        "isCoachPublished": { "type": "boolean", "description": "Coach publication flag" },
        "allowAiAdaptation": { "type": "boolean", "description": "Allow athletes to adapt via AI Adaptation Engine" },
        "createdByEmail": { "type": "string", "maxLength": 150, "description": "Author coach email (risneraryan@gmail.com)" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "title", "category", "exercises", "isPublished", "createdByEmail"]
    },
    "PtTestLog": {
      "title": "PtTestLog",
      "description": "Recorded military physical fitness test score log (5-Event AFT or General PFT) with per-event scores, pass status, and promotion point estimates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique PT test record identifier" },
        "userId": { "type": "string", "description": "Firebase Auth user ID of the service member" },
        "athleteId": { "type": "string", "maxLength": 128, "description": "Athlete profile identifier" },
        "testType": { "type": "string", "enum": ["aft", "general_pft"], "description": "Type of military fitness evaluation" },
        "standard": { "type": "string", "enum": ["combat", "general"], "description": "Combat MOS (sex-neutral) vs General MOS standard" },
        "sex": { "type": "string", "enum": ["male", "female"], "description": "Scoring table gender column when General standard is selected" },
        "ageBracket": { "type": "string", "maxLength": 20, "description": "Official age bracket (e.g., 22-26)" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Test date in YYYY-MM-DD format" },
        "tag": { "type": "string", "enum": ["baseline", "mock", "rehearsal", "record"], "description": "Evaluation milestone classification" },
        "events": { "type": "array", "description": "Array of scored event records (up to 10)" },
        "totalScore": { "type": "number", "description": "Cumulative point score" },
        "maxScore": { "type": "number", "description": "Maximum possible score (500 for AFT, 300 for General PFT)" },
        "passed": { "type": "boolean", "description": "Whether all events and total met passing minimums" },
        "promotionPoints": { "type": "number", "description": "Estimated SGT/SSG promotion points" },
        "notes": { "type": "string", "maxLength": 1500, "description": "Test conditions and reflection notes" },
        "createdAt": { "type": "string", "maxLength": 100, "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "maxLength": 100, "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "testType", "standard", "sex", "ageBracket", "date", "tag", "events", "totalScore", "maxScore", "passed"]
    },
    "UserActiveProgram": {
      "title": "UserActiveProgram",
      "description": "Decoupled active program track state storing active_track_id, volume_tier, constraint_mode, and non-punitive sequential_day_index independently of user performance benchmarks.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "maxLength": 128, "description": "Firebase Auth user ID of the athlete" },
        "active_track_id": {
          "type": "string",
          "maxLength": 100,
          "description": "Currently active tactical program track identifier (hybrid_db, apex_protocol, tactical_hypertrophy, hybrid_protocol, aft_protocol, universal_pat, custom_ai, or coach:<id>)"
        },
        "volume_tier": {
          "type": "string",
          "enum": ["standard", "high_volume"],
          "description": "Selected weekly frequency and accessory volume tier"
        },
        "constraint_mode": {
          "type": "string",
          "enum": ["full_duty", "low_impact_rehab", "minimal_gear"],
          "description": "Operational readiness or equipment constraint mode"
        },
        "sequential_day_index": { "type": "number", "description": "1-based non-punitive sequential day index" },
        "completed_sessions_count": { "type": "number", "description": "Total completed sessions across all tracks" },
        "last_completed_date": { "type": "string", "maxLength": 40, "description": "ISO date of last completed session" },
        "updated_at": { "type": "string", "maxLength": 100, "description": "Last update ISO timestamp" }
      },
      "required": ["user_id", "active_track_id", "volume_tier", "constraint_mode", "sequential_day_index"]
    },
    "GlobalBenchmarkLog": {
      "title": "GlobalBenchmarkLog",
      "description": "Decoupled global movement benchmark record tied strictly to user_id and movement_id (never track_id) so PRs, working weights, and erg/run times persist across track switches.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique document ID (user_id + movement_id)" },
        "user_id": { "type": "string", "maxLength": 128, "description": "Firebase Auth user ID of the owning athlete" },
        "movement_id": { "type": "string", "maxLength": 80, "description": "Canonical global movement identifier" },
        "movement_name": { "type": "string", "maxLength": 120, "description": "Human-readable movement name" },
        "metric_type": {
          "type": "string",
          "enum": ["load_pr", "bodyweight_reps", "time_trial", "erg_split", "carry_load"],
          "description": "Primary performance metric classification"
        },
        "best_weight_lbs": { "type": "number", "description": "Best logged load in pounds" },
        "best_reps": { "type": "number", "description": "Best logged reps" },
        "estimated_1rm_lbs": { "type": "number", "description": "Estimated 1-rep max in pounds" },
        "best_time_seconds": { "type": "number", "description": "Best benchmark time in seconds" },
        "best_time_formatted": { "type": "string", "maxLength": 24, "description": "Formatted benchmark time string" },
        "best_distance_meters": { "type": "number", "description": "Best logged distance in meters" },
        "last_rpe": { "type": "number", "description": "Most recent RPE (1-10)" },
        "last_logged_date": { "type": "string", "maxLength": 30, "description": "Date of most recent entry" },
        "session_count": { "type": "number", "description": "Number of logged sessions for this movement" },
        "history": { "type": "array", "description": "Bounded recent history entries (max 50)" },
        "updated_at": { "type": "string", "maxLength": 100, "description": "Last update ISO timestamp" }
      },
      "required": ["id", "user_id", "movement_id", "movement_name", "metric_type", "last_logged_date"]
    }
  },
  "firestore": {
    "/athletes/{athleteId}": {
      "schema": "Athlete",
      "description": "Collection of athlete profiles storing biometrics and personal goals, scoped to authenticated users."
    },
    "/workoutLogs/{logId}": {
      "schema": "WorkoutSessionLog",
      "description": "Collection of recorded workout logs tracking volume, sets, and exercises, accessible by the logging athlete."
    },
    "/customPrograms/{programId}": {
      "schema": "CustomProgram",
      "description": "Collection of custom workout programs created by athletes."
    },
    "/ruckLogs/{ruckId}": {
      "schema": "RuckSessionLog",
      "description": "Collection of rucking progression logs tracking distance, pack weight, and pace."
    },
    "/ptTestLogs/{testId}": {
      "schema": "PtTestLog",
      "description": "Collection of AFT and General PFT test score logs scoped strictly to the owning service member."
    },
    "/officerPrograms/{programId}": {
      "schema": "OfficerProgram",
      "description": "Private individualized officer programs uploaded specifically to one officer account and inaccessible to any other officer."
    },
    "/coachPrograms/{programId}": {
      "schema": "CoachProgram",
      "description": "Shared custom programs and standalone workouts created exclusively by Coach Aryan Risner and readable by all signed-in athletes when published."
    },
    "/user_active_program/{userId}": {
      "schema": "UserActiveProgram",
      "description": "Active tactical track, volume tier, constraint mode, and sequential day index per user."
    },
    "/user_benchmarks_and_logs/{docId}": {
      "schema": "GlobalBenchmarkLog",
      "description": "Decoupled global movement PRs, erg splits, run times, and RPE history keyed strictly to user_id and movement_id."
    }
  }
}
